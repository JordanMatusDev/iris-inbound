# ==========================================
# SERVIDOR NITRO
# ==========================================
PORT=3001
NITRO_PORT=3001

# ==========================================
# BASE DE DATOS (Drizzle)
# ==========================================
PBX_DB_HOST='127.0.0.1'
PBX_DB_PORT=3306
PBX_DB_USER=USUARIO
PBX_DB_PASSWORD=CONTRASENA
DB_NAME_APP='contact_center'
DB_NAME_CDR='asterisk'
DB_NAME_OMBUTEL='ombutel'
DB_NAME_SONATA='sonata_dialer'

# ==========================================
# ASTERISK AMI (SSE)
# ==========================================
PBX_AMI_HOST=127.0.0.1
PBX_AMI_PORT=5038
PBX_AMI_USER=USUARIO_AMI
PBX_AMI_PASSWORD=CONTRASENA_AMI

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
JWT_SECRET='CLAVE_SECRETA_JWT'

# ==========================================
# AWS S3 (Almacenamiento externo)
# ==========================================
AWS_ACCESS_KEY_ID=ID
AWS_SECRET_ACCESS_KEY=KEY
AWS_REGION=REGION
AWS_S3_BUCKET=BUCKET

# ==========================================
# RUTAS LOCALES (Mapeo de Docker)
# ==========================================
RECORDINGS_PATH=/var/spool/asterisk/monitor

TEST=true